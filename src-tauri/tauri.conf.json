{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineHost",
  "version": "0.3.0",
  "identifier": "dev.frish07.minehost",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "MineHost", "width": 1260, "height": 820, "minWidth": 900, "minHeight": 620}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Minecraft Server Manager",
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": false},
      "nsis": {"installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": true}
    }
  }
}
